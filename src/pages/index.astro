---
import { config } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
import VoxelWorld from "../components/Background/VoxelWorld.astro";
import Profile from "../components/Profile/Profile.astro";
import Socials from "../components/Socials/Socials.astro";
import Links from "../components/Links/Links.astro";
import Footer from "../components/Footer/Footer.astro";

const { profile, links, socials, theme, footer, background } = config;
const linkCount = String(links.length).padStart(2, "0");
---

<BaseLayout>
  {background === "voxel" && <VoxelWorld />}
  <main class="page">
    <div class="page-inner">
      <div class="page-grid">
        <section class="hero-panel" aria-label="Profil">
          <div class="panel-meta">
            <span class="panel-label">PERSONAL INDEX</span>
            <span class="panel-number">01 / 01</span>
          </div>
          <Profile profile={profile} />
          <Socials socials={socials} />
          <p class="hero-caption">Düşünceler, projeler ve internet üzerindeki izler.</p>
        </section>

        <section class="links-panel" aria-labelledby="links-heading">
          <div class="section-heading">
            <div>
              <span class="section-label">EXPLORE</span>
              <h2 id="links-heading">Seçili bağlantılar</h2>
            </div>
            <span class="link-count" aria-label={`${linkCount} bağlantı`}>{linkCount}</span>
          </div>
          <Links links={links} style={theme.linkStyle} />
        </section>
      </div>
      <Footer footer={footer} />
    </div>
  </main>
</BaseLayout>
