---
import Icon from "../UI/Icon.astro";
import { isExternal } from "../../data/profile";
import type { LinkConfig } from "../../config";

interface Props {
  link: LinkConfig;
}

const { link } = Astro.props;
const external = isExternal(link.url);
---

<a
  class:list={["link-card", { "link-card--featured": link.featured }]}
  href={link.url}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
>
  <span class="link-icon">
    <Icon name={link.icon} size={20} />
  </span>
  <span class="link-body">
    <span class="link-title-row">
      <span class="link-title">{link.title}</span>
      {link.badge && <span class="link-badge">{link.badge}</span>}
    </span>
    {link.description && <span class="link-description">{link.description}</span>}
  </span>
  <Icon class="link-arrow" name="arrow" size={18} />
</a>
