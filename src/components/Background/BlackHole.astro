---
/**
 * BlackHole — an optional WebGL2 background effect.
 *
 * Renders a gravitational-lensing black hole with an accretion disk over a
 * starfield, in a single fullscreen fragment shader. It is:
 *
 *  - opt-in (enabled via `background: "blackhole"` in the config),
 *  - paused when the tab is hidden,
 *  - static when `prefers-reduced-motion` is set,
 *  - silently skipped when WebGL2 is unavailable (the page still works).
 */
import { BLACKHOLE_VERT, BLACKHOLE_FRAG } from "../../data/blackhole";
---

<canvas class="blackhole" data-blackhole aria-hidden="true"></canvas>

<script
  is:inline
  define:vars={{ BLACKHOLE_VERT, BLACKHOLE_FRAG }}
>
  (function () {
    var VERT = BLACKHOLE_VERT;
    var FRAG = BLACKHOLE_FRAG;

    var canvas = document.querySelector("canvas[data-blackhole]");
    if (!canvas) return;

    var gl = canvas.getContext("webgl2", {
      alpha: false,
      antialias: false,
      depth: false,
      powerPreference: "high-performance",
    });
    if (!gl) return;

    function compile(type, source) {
      var shader = gl.createShader(type);
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        console.error("[ptree] shader error:", gl.getShaderInfoLog(shader));
        gl.deleteShader(shader);
        return null;
      }
      return shader;
    }

    var vs = compile(gl.VERTEX_SHADER, VERT);
    var fs = compile(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;

    var program = gl.createProgram();
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.error("[ptree] shader link error:", gl.getProgramInfoLog(program));
      return;
    }

    gl.useProgram(program);
    var uTime = gl.getUniformLocation(program, "uTime");
    var uRes = gl.getUniformLocation(program, "uRes");

    var vao = gl.createVertexArray();
    gl.bindVertexArray(vao);
    gl.disable(gl.DEPTH_TEST);

    // The geodesic shader is expensive, so the backing store is rendered at a
    // fraction of the CSS size and upscaled. Still crisp on a dark background.
    function resize() {
      var scale = window.innerWidth < 640
        ? 0.48
        : window.innerWidth < 1100
          ? 0.58
          : 0.68;
      var w = Math.max(1, Math.round(window.innerWidth * scale));
      var h = Math.max(1, Math.round(window.innerHeight * scale));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
      }
      gl.viewport(0, 0, w, h);
    }

    window.addEventListener("resize", resize);
    resize();

    var reduced = window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var raf = 0;
    var start = performance.now();

    function render(now) {
      gl.uniform1f(uTime, (now - start) / 1000);
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!reduced) raf = requestAnimationFrame(render);
    }

    function onVisibility() {
      if (document.hidden) {
        cancelAnimationFrame(raf);
      } else if (!reduced) {
        raf = requestAnimationFrame(render);
      }
    }
    document.addEventListener("visibilitychange", onVisibility);

    if (reduced) {
      // Single static frame, no animation loop.
      gl.uniform1f(uTime, 0);
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    } else {
      raf = requestAnimationFrame(render);
    }
  })();
</script>
